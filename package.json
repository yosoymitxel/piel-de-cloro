{
  "name": "piel-de-cloro",
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand --forceExit",
    "validate:dialogues": "node tools/validate-dialogue-data.mjs",
    "test:clean": "node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand --silent --no-colors --forceExit",
    "build:npc-art": "node tools/build-npc-pixel-art.mjs",
    "validate:structure": "node tools/validate-ui-methods.mjs",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "jest": "^29.6.0"
  },
  "jest": {
    "testEnvironment": "node",
    "testTimeout": 10000,
    "setupFilesAfterEnv": [
      "<rootDir>/jest.setup.js"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/e2e/"
    ]
  }
}
